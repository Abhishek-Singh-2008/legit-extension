{
  "name": "leetcode-github-sync",
  "version": "1.0.1",
  "description": "Chrome Extension: Automatically sync LeetCode accepted solutions to GitHub",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "build:fast": "vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": ["chrome-extension", "leetcode", "github", "sync"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.327",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-web-extension": "^4.1.2"
  }
}
